+  File open(const char* path) {
+    if (strcmp(path, "/com_prefs") == 0 && has_legacy_) return File(&legacy_, false);
+    if (strcmp(path, "/prefs.json") == 0 && has_prefs_) return File(&prefs_, false);
+    return {};

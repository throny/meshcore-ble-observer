@@ -0,0 +1,76 @@
+#pragma once
+
+#include <helpers/CommonCLI.h>
+#include "ObserverPolicy.h"
+
+namespace observer {
+
+class ObserverNodePrefs : public NodePrefs {
+ public:
+  static constexpr uint8_t kObserverVersion = 1;
+  uint8_t observer_enabled = 0;
+  uint8_t observer_peer_present = 0;
+  uint8_t observer_peer_type = 0;
+  uint8_t observer_peer_address[6]{};
+  uint8_t observer_version_ = 0;
+
+ protected:
+  void structure() override {
+    NodePrefs::structure();
+    def("observer_v", observer_version_);
+    def("observer_en", observer_enabled);
+    def("observer_peer_on", observer_peer_present);
+    def("observer_peer_type", observer_peer_type);
+    def("observer_peer_addr", observer_peer_address, sizeof(observer_peer_address));
+  }
+
+ public:
+  template <typename Save>
+  bool persistEnabled(bool enabled, Save save) {
+    const uint8_t previous_enabled = observer_enabled;
+    const uint8_t previous_version = observer_version_;
+    const uint8_t previous_peer_present = observer_peer_present;
+    const uint8_t previous_peer_type = observer_peer_type;
+    uint8_t previous_peer_address[sizeof(observer_peer_address)];
+    memcpy(previous_peer_address, observer_peer_address, sizeof(previous_peer_address));
+
+    observer_version_ = kObserverVersion;
+    observer_enabled = enabled ? 1 : 0;
+    if (previous_version != kObserverVersion) {
+      observer_peer_present = 0;
+      observer_peer_type = 0;
+      memset(observer_peer_address, 0, sizeof(observer_peer_address));
+    }
+    if (save()) return true;
+    observer_enabled = previous_enabled;
+    observer_version_ = previous_version;
+    observer_peer_present = previous_peer_present;
+    observer_peer_type = previous_peer_type;
+    memcpy(observer_peer_address, previous_peer_address, sizeof(previous_peer_address));
+    return false;
+  }
+
+  template <typename Save>
+  bool persistPeer(bool has_peer, const PeerIdentity& peer, Save save) {
+    const uint8_t previous_present = observer_peer_present;
+    const uint8_t previous_version = observer_version_;
+    const uint8_t previous_enabled = observer_enabled;
+    const uint8_t previous_type = observer_peer_type;
+    uint8_t previous_address[sizeof(observer_peer_address)];
+    memcpy(previous_address, observer_peer_address, sizeof(previous_address));
+
+    observer_version_ = kObserverVersion;
+    observer_peer_present = has_peer ? 1 : 0;
+    observer_peer_type = peer.type;
+    memcpy(observer_peer_address, peer.address, sizeof(peer.address));
+    if (save()) return true;
+    observer_peer_present = previous_present;
+    observer_version_ = previous_version;
+    observer_enabled = previous_enabled;
+    observer_peer_type = previous_type;
+    memcpy(observer_peer_address, previous_address, sizeof(previous_address));
+    return false;
+  }
+};
+
+}  // namespace observer
diff --git a/src/observer/ObserverPolicy.h b/src/observer/ObserverPolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..7e8ffc596e8b1645ab3f3d7180b042e932c7439d
--- /dev/null
+++ b/src/observer/ObserverPolicy.h
@@ -0,0 +1,77 @@
+#pragma once
+
+#include <stdint.h>
+#include <string.h>
+
+namespace observer {
+
+struct PeerIdentity {
+  uint8_t type = 0;
+  uint8_t address[6]{};
+};
+
+inline bool samePeer(const PeerIdentity& left, const PeerIdentity& right) {
+  return left.type == right.type && memcmp(left.address, right.address, sizeof(left.address)) == 0;
+}
+
+class Policy {
+ public:
+  Policy(bool enabled = false, const PeerIdentity& peer = PeerIdentity{}, bool has_peer = false)
+      : enabled_(enabled), peer_(peer), has_peer_(has_peer) {}
+
+  bool enabled() const { return enabled_; }
+  void setEnabled(bool enabled) { enabled_ = enabled; }
+  bool hasPeer() const { return has_peer_; }
+  const PeerIdentity& peer() const { return peer_; }
+
+  void openEnrollment(uint32_t now, uint32_t duration_ms) {
+    if (duration_ms == 0 || duration_ms > kMaximumEnrollmentMs || has_peer_) return;
+    enrollment_started_ = now;
+    enrollment_duration_ = duration_ms;
+    enrollment_open_ = true;
+  }
+
+  void closeEnrollment() { enrollment_open_ = false; }
+
+  bool enrollmentOpen(uint32_t now) const {
+    return enrollment_open_ && static_cast<uint32_t>(now - enrollment_started_) < enrollment_duration_;
+  }
+
+  bool enroll(const PeerIdentity& peer, uint32_t now) {
+    if (!enabled_ || !enrollmentOpen(now) || has_peer_) return false;
+    peer_ = peer;
+    has_peer_ = true;
+    enrollment_open_ = false;
+    return true;
+  }
+
+  bool restorePeer(const PeerIdentity& peer) {
+    peer_ = peer;
+    has_peer_ = true;
+    return true;
+  }
+
+  bool authorizes(bool connected, const PeerIdentity& peer, uint32_t now = 0) const {
+    return enabled_ && has_peer_ && connected && !enrollmentOpen(now) &&
+           peer.type == peer_.type &&
+           memcmp(peer.address, peer_.address, sizeof(peer.address)) == 0;
+  }
+
+  void revoke() {
+    has_peer_ = false;
+    memset(&peer_, 0, sizeof(peer_));
+    closeEnrollment();
+  }
+
+  static constexpr uint32_t kMaximumEnrollmentMs = 60000;
+
+ private:
+  bool enabled_ = false;
+  PeerIdentity peer_{};
+  bool has_peer_ = false;
+  bool enrollment_open_ = false;
+  uint32_t enrollment_started_ = 0;
+  uint32_t enrollment_duration_ = 0;
+};
+
+}  // namespace observer
diff --git a/src/observer/ObserverPreference.h b/src/observer/ObserverPreference.h
new file mode 100644
index 0000000000000000000000000000000000000000..f9146eb23cdcea096067cd199db3662f054d5a61
--- /dev/null
+++ b/src/observer/ObserverPreference.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "ObserverPolicy.h"
+
+namespace observer {
+
+struct PreferenceStore {
+  virtual ~PreferenceStore() = default;
+  virtual bool read(const char* key, uint8_t* output, size_t length) = 0;
+  virtual bool write(const char* key, const uint8_t* value, size_t length) = 0;
+  virtual bool remove(const char* key) = 0;
+};
+
+class Preferences {
+ public:
+  explicit Preferences(PreferenceStore& store) : store_(store) {}
+
+  bool load(bool& enabled, PeerIdentity& peer, bool& has_peer) {
+    enabled = false;
+    has_peer = false;
+    uint8_t version = 0;
+    if (!store_.read("observer_v", &version, 1)) return true;
+    if (version != kVersion) return false;
+    uint8_t enabled_byte = 0;
+    if (store_.read("observer_en", &enabled_byte, 1)) enabled = enabled_byte == 1;
+    uint8_t identity[7]{};
+    if (store_.read("observer_peer", identity, sizeof(identity))) {
+      peer.type = identity[0];
+      memcpy(peer.address, identity + 1, 6);
+      has_peer = true;
+    }
+    return true;
+  }
+
+  bool saveEnabled(bool enabled) {
+    const uint8_t version = kVersion;
+    const uint8_t value = enabled ? 1 : 0;
+    return store_.write("observer_v", &version, 1) && store_.write("observer_en", &value, 1);
+  }
+
+  bool savePeer(bool has_peer, const PeerIdentity& peer) {
+    const uint8_t version = kVersion;
+    if (!store_.write("observer_v", &version, 1)) return false;
+    if (!has_peer) return store_.remove("observer_peer");
+    uint8_t identity[7]{};
+    identity[0] = peer.type;
+    memcpy(identity + 1, peer.address, 6);
+    return store_.write("observer_peer", identity, sizeof(identity));
+  }
+
+  static constexpr uint8_t kVersion = 1;
+
+ private:
+  PreferenceStore& store_;
+};
+
+}  // namespace observer
diff --git a/src/observer/ObserverProtocol.h b/src/observer/ObserverProtocol.h
new file mode 100644
index 0000000000000000000000000000000000000000..44a8eeda556b9f250eb90857ddb10eb75dd47170
--- /dev/null
+++ b/src/observer/ObserverProtocol.h
@@ -0,0 +1,74 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+namespace observer {
+
+constexpr size_t kFrameHeaderBytes = 16;
+constexpr size_t kMaximumRecordBytes = 256;
+constexpr size_t kMaximumAckBytes = 95;
+
+struct Ack {
+  uint64_t boot_nonce = 0;
+  uint32_t sequence = 0;
+};
+
+inline size_t encodeFrame(uint64_t boot_nonce, uint32_t sequence, uint16_t total_length,
+                          uint16_t offset, const uint8_t* bytes, size_t length,
+                          uint8_t* output, size_t capacity) {
+  if (!output || !bytes || sequence == 0 || total_length == 0 || total_length > kMaximumRecordBytes ||
+      offset > total_length || length == 0 || length > total_length - offset ||
+      length + kFrameHeaderBytes > capacity) return 0;
+  for (unsigned index = 0; index < 8; ++index) output[index] = static_cast<uint8_t>(boot_nonce >> (index * 8));
+  for (unsigned index = 0; index < 4; ++index) output[8 + index] = static_cast<uint8_t>(sequence >> (index * 8));
+  output[12] = static_cast<uint8_t>(total_length);
+  output[13] = static_cast<uint8_t>(total_length >> 8);
+  output[14] = static_cast<uint8_t>(offset);
+  output[15] = static_cast<uint8_t>(offset >> 8);
+  memcpy(output + kFrameHeaderBytes, bytes, length);
+  return kFrameHeaderBytes + length;
+}
+
+inline bool formatAck(uint64_t boot_nonce, uint32_t sequence, char* output, size_t capacity) {
+  if (!output || capacity < 31 || sequence == 0) return false;
+  const int length = snprintf(output, capacity, "ack %016llx %u",
+                              static_cast<unsigned long long>(boot_nonce), sequence);
+  return length > 0 && static_cast<size_t>(length) < capacity;
+}
+
+inline bool parseAck(const char* bytes, size_t length, Ack& ack) {
+  constexpr char prefix[] = "ack ";
+  if (!bytes || length >= kMaximumAckBytes || length < sizeof(prefix) - 1 + 16 + 2 ||
+      memcmp(bytes, prefix, sizeof(prefix) - 1) != 0) return false;
+  const size_t nonce_start = sizeof(prefix) - 1;
+  for (size_t index = 0; index < 16; ++index) {
+    const char c = bytes[nonce_start + index];
+    if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) return false;
+  }
+  const size_t separator = nonce_start + 16;
+  if (bytes[separator] != ' ') return false;
+  uint64_t nonce = 0;
+  for (size_t index = 0; index < 16; ++index) {
+    const char c = bytes[nonce_start + index];
+    nonce = (nonce << 4) | static_cast<uint64_t>(c <= '9' ? c - '0' : c - 'a' + 10);
+  }
+  const size_t sequence_start = separator + 1;
+  if (sequence_start == length || (bytes[sequence_start] == '0' && sequence_start + 1 != length)) return false;
+  uint32_t sequence = 0;
+  for (size_t index = sequence_start; index < length; ++index) {
+    const char c = bytes[index];
+    if (c < '0' || c > '9') return false;
+    const uint32_t digit = static_cast<uint32_t>(c - '0');
+    if (sequence > (UINT32_MAX - digit) / 10) return false;
+    sequence = sequence * 10 + digit;
+  }
+  if (sequence == 0) return false;
+  ack.boot_nonce = nonce;
+  ack.sequence = sequence;
+  return true;
+}
+
+}  // namespace observer
diff --git a/src/observer/ObserverRecordQueue.h b/src/observer/ObserverRecordQueue.h
new file mode 100644
index 0000000000000000000000000000000000000000..fe244b1659c85bc9151900a1cfc4e8ef538a53ff
--- /dev/null
+++ b/src/observer/ObserverRecordQueue.h
@@ -0,0 +1,238 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace observer {
+
+class QueueSequenceState {
+ public:
+  uint32_t next() const { return next_; }
+  void advance(uint32_t assigned) {
+    next_ = assigned + 1;
+  }
+  void restart() { next_ = 1; }
+  void skip() { if (next_ != 0) advance(next_); }
+ private:
+  uint32_t next_ = 1;
+};
+
+struct RecordFragment {
+  uint64_t boot_nonce;
+  uint32_t sequence;
+  uint16_t total_length;
+  uint16_t offset;
+  const uint8_t* bytes;
+  uint16_t length;
+};
+
+template <size_t ByteCapacity, size_t RecordCapacity>
+class RecordQueue {
+ public:
+  explicit RecordQueue(bool enabled = true, uint64_t boot_nonce = 0, uint32_t next_sequence = 1)
+      : enabled_(enabled), boot_nonce_(boot_nonce), next_sequence_(next_sequence ? next_sequence : 1) {}
+  RecordQueue(bool enabled, uint64_t boot_nonce, QueueSequenceState& sequence)
+      : enabled_(enabled), boot_nonce_(boot_nonce), next_sequence_(sequence.next()), sequence_(&sequence) {}
+
+  bool enqueue(const uint8_t* bytes, size_t length) {
+    if (!enabled_) return true;
+    if (!bytes || length == 0 || length > kMaxRecordLength) {
+      drop(length);
+      return false;
+    }
+    // Zero means exhausted, not reusable sequence 1. Only the loop-side nonce
+    // rotation can reopen admission; do not evict backlog while entropy waits.
+    if (sequenceExhausted()) {
+      rejectUnavailable(length);
+      return false;
+    }
+    while (length > availableBytes() || record_count_ == RecordCapacity) {
+      if (record_count_ == 0) {
+        drop(length);
+        return false;
+      }
+      dropHeadRecord();
+    }
+    if (length > availableBytes() || record_count_ == RecordCapacity) {
+      drop(length);
+      return false;
+    }
+    if (byte_count_ == 0) byte_tail_ = byte_head_;
+    const bool was_empty = record_count_ == 0;
+    Record& record = records_[record_tail_];
+    record.boot_nonce = boot_nonce_;
+    record.sequence = next_sequence_++;
+    if (sequence_) sequence_->advance(record.sequence);
+    record.start = byte_tail_;
+    record.length = length;
+    record.consumed = 0;
+    record.transmit_offset = 0;
+    for (size_t index = 0; index < length; ++index) {
+      bytes_[byte_tail_] = bytes[index];
+      byte_tail_ = (byte_tail_ + 1) % ByteCapacity;
+    }
+    byte_count_ += length;
+    if (was_empty) byte_head_ = record.start;
+    record_tail_ = (record_tail_ + 1) % RecordCapacity;
+    ++record_count_;
+    return true;
+  }
+
+  bool sequenceExhausted() const { return next_sequence_ == 0; }
+  bool setBootNonce(uint64_t boot_nonce) {
+    if (!sequenceExhausted() || boot_nonce == 0 || boot_nonce == boot_nonce_) return false;
+    boot_nonce_ = boot_nonce;
+    next_sequence_ = 1;
+    if (sequence_) sequence_->restart();
+    return true;
+  }
+
+  bool peek(RecordFragment& fragment, size_t maximum) const {
+    if (record_count_ == 0) return false;
+    const Record& record = records_[record_head_];
+    fragment.boot_nonce = record.boot_nonce;
+    fragment.sequence = record.sequence;
+    fragment.total_length = record.length;
+    fragment.offset = static_cast<uint16_t>(record.transmit_offset);
+    fragment.bytes = &bytes_[(record.start + record.transmit_offset) % ByteCapacity];
+    const size_t contiguous = ByteCapacity - ((record.start + record.transmit_offset) % ByteCapacity);
+    const size_t remaining = record.length - record.transmit_offset;
+    fragment.length = remaining < maximum ? remaining : maximum;
+    if (fragment.length > contiguous) fragment.length = contiguous;
+    return true;
+  }
+
+  bool consume(uint64_t boot_nonce, uint32_t sequence, size_t length) {
+    if (record_count_ == 0 || boot_nonce != records_[record_head_].boot_nonce || records_[record_head_].sequence != sequence) return false;
+    Record& record = records_[record_head_];
+    if (length > record.length - record.transmit_offset) return false;
+    record.transmit_offset += length;  // progress only; storage stays until complete Pi ACK
+    return true;
+  }
+
+  void consume(size_t length) {
+    if (record_count_ == 0) return;
+    consume(records_[record_head_].boot_nonce, records_[record_head_].sequence, length);
+  }
+
+  void dropHeadRecord() {
+    if (record_count_ == 0) return;
+    Record& record = records_[record_head_];
+    const size_t remaining = record.length;
+    ++dropped_records_;
+    dropped_bytes_ += remaining;
+    ++evicted_records_;
+    evicted_bytes_ += remaining;
+    byte_count_ -= remaining;
+    byte_head_ = (byte_head_ + remaining) % ByteCapacity;
+    if (record_count_ > 1) byte_head_ = records_[(record_head_ + 1) % RecordCapacity].start;
+    removeHead();
+  }
+
+  void drop(size_t length) {
+    if (!enabled_) return;
+    reserveLostIdentity();
+    ++dropped_records_;
+    dropped_bytes_ += length;
+    ++truncated_records_;
+    truncated_bytes_ += length;
+  }
+
+  void rejectUnavailable(size_t length) {
+    if (!enabled_) return;
+    reserveLostIdentity();
+    ++dropped_records_;
+    dropped_bytes_ += length;
+    ++unavailable_records_;
+    unavailable_bytes_ += length;
+  }
+
+  bool empty() const { return record_count_ == 0; }
+  void setEnabled(bool enabled) { enabled_ = enabled; }
+  size_t size() const { return record_count_; }
+  uint32_t headSequence() const { return record_count_ ? records_[record_head_].sequence : 0; }
+
+  bool acknowledge(uint64_t boot_nonce, uint32_t sequence) {
+    if (record_count_ == 0 || boot_nonce != records_[record_head_].boot_nonce || sequence == 0 ||
+        records_[record_head_].sequence != sequence) return false;
+    const size_t remaining = records_[record_head_].length;
+    byte_count_ -= remaining;
+    byte_head_ = (byte_head_ + remaining) % ByteCapacity;
+    if (record_count_ > 1) byte_head_ = records_[(record_head_ + 1) % RecordCapacity].start;
+    removeHead();
+    return true;
+  }
+
+  void restartHead() {
+    if (record_count_ != 0) records_[record_head_].transmit_offset = 0;
+  }
+
+  uint64_t bootNonce() const { return boot_nonce_; }
+
+  uint32_t droppedRecords() const { return dropped_records_; }
+  uint32_t droppedBytes() const { return dropped_bytes_; }
+  uint32_t evictedRecords() const { return evicted_records_; }
+  uint32_t evictedBytes() const { return evicted_bytes_; }
+  uint32_t truncatedRecords() const { return truncated_records_; }
+  uint32_t truncatedBytes() const { return truncated_bytes_; }
+  uint32_t unavailableRecords() const { return unavailable_records_; }
+  uint32_t unavailableBytes() const { return unavailable_bytes_; }
+
+ private:
+  void reserveLostIdentity() {
+    // Missing classic records occupy sequence positions too. Never wrap zero
+    // back to 1; a fresh loop-side nonce is required after exhaustion.
+    if (sequenceExhausted()) return;
+    const uint32_t lost = next_sequence_++;
+    if (sequence_) sequence_->advance(lost);
+  }
+
+  struct Record {
+    uint64_t boot_nonce;
+    uint32_t sequence;
+    size_t start;
+    size_t length;
+    size_t consumed;
+    size_t transmit_offset;
+  };
+
+  void removeHead() {
+    record_head_ = (record_head_ + 1) % RecordCapacity;
+    --record_count_;
+  }
+  size_t availableBytes() const { return ByteCapacity - byte_count_; }
+
+
+  uint8_t bytes_[ByteCapacity]{};
+  Record records_[RecordCapacity]{};
+  size_t byte_head_ = 0;
+  size_t byte_tail_ = 0;
+  size_t byte_count_ = 0;
+  size_t record_head_ = 0;
+  size_t record_tail_ = 0;
+  size_t record_count_ = 0;
+  static constexpr size_t kMaxRecordLength = 256;
+  uint64_t boot_nonce_ = 0;
+  uint32_t next_sequence_ = 1;
+  QueueSequenceState* sequence_ = nullptr;
+  bool enabled_;
+  uint32_t dropped_records_ = 0;
+  uint32_t dropped_bytes_ = 0;
+  uint32_t evicted_records_ = 0;
+  uint32_t evicted_bytes_ = 0;
+  uint32_t truncated_records_ = 0;
+  uint32_t truncated_bytes_ = 0;
+  uint32_t unavailable_records_ = 0;
+  uint32_t unavailable_bytes_ = 0;
+
+  void recomputeByteCount() {
+    size_t total = 0;
+    for (size_t index = 0; index < record_count_; ++index) {
+      const Record& record = records_[(record_head_ + index) % RecordCapacity];
+      total += record.length;
+    }
+    byte_count_ = total;
+  }
+};
+
+}  // namespace observer
diff --git a/src/observer/ObserverStatsSnapshot.h b/src/observer/ObserverStatsSnapshot.h
new file mode 100644
index 0000000000000000000000000000000000000000..69beb2f479505561a065e9ce2bc7f5be6c51dfde
--- /dev/null
+++ b/src/observer/ObserverStatsSnapshot.h
@@ -0,0 +1,59 @@
+#pragma once
+
+#include <stdio.h>
+#include <stdint.h>
+
+namespace observer {
+
+struct StatsValues {
+  uint32_t evicted_records = 0;
+  uint32_t evicted_bytes = 0;
+  uint32_t truncated_records = 0;
+  uint32_t truncated_bytes = 0;
+  uint32_t failed_notifications = 0;
+  uint32_t unavailable_records = 0;
+  uint32_t unavailable_bytes = 0;
+};
+
+inline size_t formatStats(const StatsValues& stats, char* buffer, size_t capacity) {
+  const int length = snprintf(buffer, capacity, "evicted=%lu/%lu truncated=%lu/%lu failed=%lu unavailable=%lu/%lu",
+      static_cast<unsigned long>(stats.evicted_records), static_cast<unsigned long>(stats.evicted_bytes),
+      static_cast<unsigned long>(stats.truncated_records), static_cast<unsigned long>(stats.truncated_bytes),
+      static_cast<unsigned long>(stats.failed_notifications),
+      static_cast<unsigned long>(stats.unavailable_records), static_cast<unsigned long>(stats.unavailable_bytes));
+  return length < 0 ? 0 : static_cast<size_t>(length);
+}
+
+// Single loop-task writer, callback-task reader. The writer fills the inactive
+// buffer and then release-publishes the active index; the reader acquire-loads the
+// index and copies a buffer the writer is not touching. The reader never spins, so
+// the higher-priority BLE callback cannot livelock the loop task mid-publish.
+class StatsSnapshot {
+ public:
+  void publish(uint32_t evicted_records, uint32_t evicted_bytes,
+               uint32_t truncated_records, uint32_t truncated_bytes,
+               uint32_t failed_notifications, uint32_t unavailable_records = 0,
+               uint32_t unavailable_bytes = 0) {
+    const uint32_t active = __atomic_load_n(&active_, __ATOMIC_ACQUIRE);
+    StatsValues& back = buffers_[active ^ 1U];
+    back.evicted_records = evicted_records;
+    back.evicted_bytes = evicted_bytes;
+    back.truncated_records = truncated_records;
+    back.truncated_bytes = truncated_bytes;
+    back.failed_notifications = failed_notifications;
+    back.unavailable_records = unavailable_records;
+    back.unavailable_bytes = unavailable_bytes;
+    __atomic_store_n(&active_, active ^ 1U, __ATOMIC_RELEASE);
+  }
+
+  StatsValues read() const {
+    const uint32_t active = __atomic_load_n(&active_, __ATOMIC_ACQUIRE);
+    return buffers_[active];
+  }
+
+ private:
+  mutable volatile uint32_t active_ = 0;
+  StatsValues buffers_[2]{};
+};
+
+}  // namespace observer
diff --git a/src/observer/ObserverStreamQueue.h b/src/observer/ObserverStreamQueue.h
new file mode 100644
index 0000000000000000000000000000000000000000..1a6bb52db5e47b7960bbc7bc218cb7eb04787206
--- /dev/null
+++ b/src/observer/ObserverStreamQueue.h
@@ -0,0 +1,57 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace observer {
+
+template <size_t Capacity>
+class StreamQueue {
+ public:
+  explicit StreamQueue(bool enabled = true) : enabled_(enabled) {}
+
+  size_t enqueue(const uint8_t* bytes, size_t length) {
+    if (!enabled_) return length;
+    if (length > available()) {
+      ++dropped_records_;
+      dropped_bytes_ += length;
+      return 0;
+    }
+    for (size_t index = 0; index < length; ++index) {
+      bytes_[tail_] = bytes[index];
+      tail_ = (tail_ + 1) % Capacity;
+    }
+    size_ += length;
+    return length;
+  }
+
+  size_t dequeue(uint8_t* destination, size_t maximum) {
+    const size_t copied = maximum < size_ ? maximum : size_;
+    for (size_t index = 0; index < copied; ++index) {
+      destination[index] = bytes_[head_];
+      head_ = (head_ + 1) % Capacity;
+    }
+    size_ -= copied;
+    return copied;
+  }
+
+  void drop(size_t length) {
+    ++dropped_records_;
+    dropped_bytes_ += length;
+  }
+  bool empty() const { return size_ == 0; }
+  size_t available() const { return Capacity - size_; }
+  uint32_t droppedRecords() const { return dropped_records_; }
+  uint32_t droppedBytes() const { return dropped_bytes_; }
+
+ private:
+  uint8_t bytes_[Capacity]{};
+  size_t head_ = 0;
+  size_t tail_ = 0;
+  size_t size_ = 0;
+  bool enabled_;
+  uint32_t dropped_records_ = 0;
+  uint32_t dropped_bytes_ = 0;
+};
+
+}  // namespace observer
diff --git a/src/observer/ObserverTransport.cpp b/src/observer/ObserverTransport.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..21ff4d6ec9af798a1e8fcb4d0de1ffe8acc36334
--- /dev/null
+++ b/src/observer/ObserverTransport.cpp
@@ -0,0 +1,564 @@
+#include "ObserverTransport.h"
+#if !defined(OBSERVER_TRANSPORT_PLATFORM_TEST)
+#include <utility/bonding.h>
+#endif
+#include <new>
+#include <stdio.h>
+
+#include "ObserverPreference.h"
+
+#if defined(SENSECAP_OBSERVER_TRANSPORT)
+
+namespace observer {
+
+namespace {
+constexpr uint8_t kServiceUuid[] = {0x1b, 0x5f, 0x6f, 0x02, 0x6b, 0x56, 0x48, 0x5e, 0xa3, 0x50, 0x61, 0x3c, 0x4a, 0x5d, 0xc2, 0x10};
+constexpr uint8_t kLogUuid[] = {0x1b, 0x5f, 0x6f, 0x03, 0x6b, 0x56, 0x48, 0x5e, 0xa3, 0x50, 0x61, 0x3c, 0x4a, 0x5d, 0xc2, 0x10};
+constexpr uint8_t kCommandUuid[] = {0x1b, 0x5f, 0x6f, 0x04, 0x6b, 0x56, 0x48, 0x5e, 0xa3, 0x50, 0x61, 0x3c, 0x4a, 0x5d, 0xc2, 0x10};
+constexpr uint8_t kAckUuid[] = {0x1b, 0x5f, 0x6f, 0x05, 0x6b, 0x56, 0x48, 0x5e, 0xa3, 0x50, 0x61, 0x3c, 0x4a, 0x5d, 0xc2, 0x10};
+constexpr uint8_t kStatsUuid[] = {0x1b, 0x5f, 0x6f, 0x06, 0x6b, 0x56, 0x48, 0x5e, 0xa3, 0x50, 0x61, 0x3c, 0x4a, 0x5d, 0xc2, 0x10};
+constexpr uint16_t kAdvertisingInterval = 1600;  // 1 second
+constexpr uint16_t kNotificationBytes = 20;
+}
+
+Transport* Transport::instance_ = nullptr;
+Transport transport(false);
+LogMirror log_mirror;
+
+Transport::Transport(bool enabled)
+    : enabled_(enabled), policy_(enabled),
+      service_(BLEUuid(kServiceUuid)), log_characteristic_(BLEUuid(kLogUuid)),
+      command_characteristic_(BLEUuid(kCommandUuid)), ack_characteristic_(BLEUuid(kAckUuid)),
+      stats_characteristic_(BLEUuid(kStatsUuid)) {}
+
+void Transport::attachPreferences(bool enabled, const PeerIdentity& peer, bool has_peer) {
+  enabled_ = enabled;
+  policy_ = Policy(enabled, peer, has_peer);
+}
+
+void Transport::setPreferenceCallbacks(bool (*save_enabled)(bool),
+                                       bool (*save_peer)(bool, const PeerIdentity&)) {
+  save_enabled_ = save_enabled;
+  save_peer_ = save_peer;
+}
+
+bool Transport::begin(const char* name, bool enabled) {
+  if (!enabled || !save_enabled_) return false;
+  if (initialization_failed_) return failInitialization();
+  enabled_ = true;
+  policy_.setEnabled(true);
+  if (initialized_) return true;
+  instance_ = this;
+  Bluefruit.configPrphBandwidth(BANDWIDTH_MAX);
+  if (!Bluefruit.begin(1, 0)) return failInitialization();
+  core_ready_ = true;
+  Bluefruit.setTxPower(0);
+  Bluefruit.setName(name);
+  Bluefruit.Security.setMITM(true);
+  Bluefruit.Security.setIOCaps(true, false, false);
+  Bluefruit.Security.setPairPasskeyCallback(onPasskey);
+  Bluefruit.Security.setPairCompleteCallback(onPairComplete);
+  Bluefruit.Periph.setConnectCallback(onConnect);
+  Bluefruit.Periph.setDisconnectCallback(onDisconnect);
+  Bluefruit.Security.setSecuredCallback(onSecured);
+  if (service_.begin() != NRF_SUCCESS) return failInitialization();
+  log_characteristic_.setProperties(CHR_PROPS_NOTIFY);
+  log_characteristic_.setPermission(SECMODE_ENC_WITH_MITM, SECMODE_NO_ACCESS);
+  log_characteristic_.setMaxLen(kNotificationBytes);
+  if (log_characteristic_.begin() != NRF_SUCCESS) return failInitialization();
+  command_characteristic_.setProperties(CHR_PROPS_WRITE);
+  command_characteristic_.setPermission(SECMODE_NO_ACCESS, SECMODE_ENC_WITH_MITM);
+  command_characteristic_.setMaxLen(kCommandBytes - 1);
+  command_characteristic_.setWriteCallback(onCommand);
+  if (command_characteristic_.begin() != NRF_SUCCESS) return failInitialization();
+  ack_characteristic_.setProperties(CHR_PROPS_WRITE);
+  ack_characteristic_.setPermission(SECMODE_NO_ACCESS, SECMODE_ENC_WITH_MITM);
+  ack_characteristic_.setMaxLen(kCommandBytes - 1);
+  ack_characteristic_.setWriteCallback(onAck);
+  if (ack_characteristic_.begin() != NRF_SUCCESS) return failInitialization();
+  stats_characteristic_.setProperties(CHR_PROPS_READ);
+  stats_characteristic_.setPermission(SECMODE_ENC_WITH_MITM, SECMODE_NO_ACCESS);
+  stats_characteristic_.setMaxLen(128);
+  stats_characteristic_.setReadAuthorizeCallback(onStats);
+  if (stats_characteristic_.begin() != NRF_SUCCESS) return failInitialization();
+  Bluefruit.Advertising.addFlags(BLE_GAP_ADV_FLAGS_LE_ONLY_GENERAL_DISC_MODE);
+  Bluefruit.Advertising.addService(service_);
+  Bluefruit.ScanResponse.addName();
+  Bluefruit.Advertising.setInterval(kAdvertisingInterval, kAdvertisingInterval);
+  Bluefruit.Advertising.restartOnDisconnect(false);
+  initialized_ = true;
+  // Accepted opt-in, not entropy readiness. The loop acquires entropy before
+  // allocating capture storage or making the peripheral discoverable.
+  return true;
+}
+
+bool Transport::failInitialization() {
+  // Bluefruit has no safe end()/partial-GATT rollback API. Fail closed and
+  // require reboot instead of registering duplicate services on another opt-in.
+  initialization_failed_ = true;
+  initialized_ = false;
+  enabled_ = false;
+  policy_.setEnabled(false);
+  policy_.closeEnrollment();
+  onboarding_ = false;
+  if (core_ready_) Bluefruit.Advertising.stop();
+  releaseQueue();
+  if (save_enabled_) save_enabled_(false);
+  return false;
+}
+
+void Transport::serviceAdvertising() {
+  const bool discoverable = enabled_ && initialized_ && nonce_ready_ && log_queue_ &&
+      (policy_.hasPeer() || policy_.enrollmentOpen(millis()));
+  if (!discoverable) {
+    if (Bluefruit.Advertising.isRunning()) Bluefruit.Advertising.stop();
+  } else if (connectionHandle() == BLE_CONN_HANDLE_INVALID && !Bluefruit.Advertising.isRunning()) {
+    Bluefruit.Advertising.start(0);
+  }
+}
+
+bool Transport::authorizedAndSecured(uint16_t handle) const {
+  BLEConnection* connection = Bluefruit.Connection(handle);
+  if (!connection || !connection->connected() || !connection->bonded() || !connection->secured()) return false;
+  const ble_gap_addr_t peer_address = connection->getPeerAddr();
+  PeerIdentity identity{};
+  identity.type = peer_address.addr_type;
+  memcpy(identity.address, peer_address.addr, sizeof(identity.address));
+  const bool allowed = policy_.authorizes(true, identity, millis());
+  if (!allowed && !policy_.enrollmentOpen(millis())) connection->disconnect();
+  return allowed;
+}
+
+void Transport::setConnectionHandle(uint16_t handle) {
+  __atomic_store_n(&connection_handle_, handle, __ATOMIC_RELEASE);
+}
+
+uint16_t Transport::connectionHandle() const {
+  return __atomic_load_n(&connection_handle_, __ATOMIC_ACQUIRE);
+}
+
+bool Transport::refreshNonce(bool rotate) {
+  if (nonce_ready_ && !rotate) return true;
+  if (!core_ready_) return false;
+  const uint32_t now = millis();
+  if (entropy_attempted_ && static_cast<uint32_t>(now - entropy_attempt_at_) < kEntropyRetryMs) return false;
+  entropy_attempted_ = true;
+  entropy_attempt_at_ = now;
+  uint8_t available = 0;
+  if (sd_rand_application_bytes_available_get(&available) != NRF_SUCCESS || available < 8) return false;
+  uint8_t bytes[8]{};
+  if (sd_rand_application_vector_get(bytes, sizeof(bytes)) != NRF_SUCCESS) return false;
+  uint64_t nonce = 0;
+  for (unsigned index = 0; index < sizeof(bytes); ++index) nonce |= static_cast<uint64_t>(bytes[index]) << (index * 8);
+  if (nonce == 0 || nonce == boot_nonce_) return false;
+  boot_nonce_ = nonce;
+  nonce_ready_ = true;
+  return true;
+}
+
+bool Transport::enable(bool enabled) {
+  if (!save_enabled_ || !save_enabled_(enabled)) return false;
+  if (!initialized_) {
+    if (!enabled) { enabled_ = false; policy_.setEnabled(false); return true; }
+    enabled_ = true;
+    policy_.setEnabled(true);
+    if (!begin("SenseCAP Observer", true)) return false;
+    return true;
+  }
+  enabled_ = enabled;
+  policy_.setEnabled(enabled);
+
+  if (!enabled) {
+    closeEnrollment();
+    __atomic_store_n(&passkey_allowed_handle_, BLE_CONN_HANDLE_INVALID, __ATOMIC_RELEASE);
+    __atomic_store_n(&passkey_pending_, false, __ATOMIC_RELEASE);
+    disable_pending_ = true;
+    enabled_ = false;
+    policy_.setEnabled(false);
+    Bluefruit.Advertising.stop();
+    if (connectionHandle() != BLE_CONN_HANDLE_INVALID) {
+      BLEConnection* connection = Bluefruit.Connection(connectionHandle());
+      if (connection) connection->disconnect();
+    }
+    __atomic_store_n(&secured_, false, __ATOMIC_RELEASE);
+    return true;
+  }
+  disable_pending_ = false;
+  policy_.setEnabled(true);
+  return true;
+}
+
+bool Transport::revokePeer() {
+  if (!policy_.hasPeer()) return true;
+  ble_gap_addr_t address{};
+  address.addr_type = policy_.peer().type;
+  memcpy(address.addr, policy_.peer().address, sizeof(address.addr));
+  if (!persistPeer(false, PeerIdentity{})) return false;
+  bond_remove_key(BLE_GAP_ROLE_PERIPH, &address);
+  policy_.revoke();
+  if (connectionHandle() != BLE_CONN_HANDLE_INVALID) {
+    BLEConnection* connection = Bluefruit.Connection(connectionHandle());
+    if (connection) connection->disconnect();
+  }
+  return true;
+}
+
+bool Transport::beginEnrollment() {
+  if (!enabled_ || !initialized_ || !nonce_ready_ || !log_queue_ || !Serial) return false;
+  if (connectionHandle() != BLE_CONN_HANDLE_INVALID) {
+    BLEConnection* connection = Bluefruit.Connection(connectionHandle());
+    if (connection) connection->disconnect();
+    __atomic_store_n(&secured_, false, __ATOMIC_RELEASE);
+  }
+  if (policy_.hasPeer()) {
+    if (!revokePeer()) return false;
+    policy_.setEnabled(true);
+  }
+  onboarding_ = true;
+  enrollment_handle_ = BLE_CONN_HANDLE_INVALID;
+  enrollment_started_ = millis();
+  policy_.openEnrollment(enrollment_started_, kEnrollmentWindowMs);
+  if (!policy_.enrollmentOpen(enrollment_started_)) { onboarding_ = false; return false; }
+  Bluefruit.Security.setMITM(true);
+  Bluefruit.Security.setIOCaps(true, false, false);
+  Bluefruit.Security.setPairPasskeyCallback(onPasskey);
+  Bluefruit.Security.setPairCompleteCallback(onPairComplete);
+  serviceAdvertising();
+  Serial.println("Observer BLE enrollment open for 60 seconds; pair the intended Pi now.");
+  return true;
+}
+
+bool Transport::processAck(const char* bytes, size_t length) {
+  Ack ack{};
+  if (!parseAck(bytes, length, ack)) return false;
+  const bool acknowledged = log_queue_ && log_queue_->acknowledge(ack.boot_nonce, ack.sequence);
+  if (acknowledged) {
+    delivery_.acknowledged();
+    __atomic_store_n(&complete_record_sent_, false, __ATOMIC_RELEASE);
+  }
+  return acknowledged;
+}
+
+void Transport::onConnect(uint16_t handle) {
+  if (instance_) instance_->callback_events_.postConnect(handle);
+}
+
+void Transport::onDisconnect(uint16_t handle, uint8_t) {
+  if (instance_) instance_->callback_events_.postDisconnect(handle);
+}
+
+void Transport::onSecured(uint16_t handle) {
+  if (instance_) instance_->callback_events_.postSecured(handle);
+}
+
+void Transport::onCommand(uint16_t handle, BLECharacteristic*, uint8_t* data, uint16_t length) {
+  if (!instance_ || !__atomic_load_n(&instance_->secured_, __ATOMIC_ACQUIRE) || !instance_->authorizedAndSecured(handle) || length == 0 ||
+      length >= kCommandBytes) return;
+  if (length >= 4 && memcmp(data, "ack ", 4) == 0) return;
+  instance_->command_ingress_.submitCommand(reinterpret_cast<const char*>(data), length);
+}
+
+void Transport::onAck(uint16_t handle, BLECharacteristic*, uint8_t* data, uint16_t length) {
+  if (!instance_ || !__atomic_load_n(&instance_->secured_, __ATOMIC_ACQUIRE) || !instance_->authorizedAndSecured(handle) || !length ||
+      length >= kCommandBytes) return;
+  instance_->ack_ingress_.submit(reinterpret_cast<const char*>(data), length);
+}
+
+void Transport::onStats(uint16_t handle, BLECharacteristic*, ble_gatts_evt_read_t* request) {
+  if (!instance_ || !instance_->authorizedAndSecured(handle)) return;
+  char buffer[128]{};
+  const StatsValues stats = instance_->stats_snapshot_.read();
+  const uint16_t length = static_cast<uint16_t>(formatStats(stats, buffer, sizeof(buffer)));
+  if (request->offset > length) return;
+  ble_gatts_rw_authorize_reply_params_t reply{};
+  reply.type = BLE_GATTS_AUTHORIZE_TYPE_READ;
+  reply.params.read.gatt_status = BLE_GATT_STATUS_SUCCESS;
+  reply.params.read.update = 1;
+  reply.params.read.len = length - request->offset;
+  reply.params.read.offset = request->offset;
+  reply.params.read.p_data = reinterpret_cast<uint8_t*>(buffer + request->offset);
+  sd_ble_gatts_rw_authorize_reply(handle, &reply);
+}
+
+bool Transport::onPasskey(uint16_t handle, uint8_t const passkey[6], bool match_request) {
+  if (!instance_ || match_request ||
+      __atomic_load_n(&instance_->passkey_allowed_handle_, __ATOMIC_ACQUIRE) != handle) return false;
+  memcpy(instance_->pending_passkey_, passkey, sizeof(instance_->pending_passkey_));
+  __atomic_store_n(&instance_->passkey_state_, 1, __ATOMIC_RELEASE);
+  __atomic_store_n(&instance_->passkey_pending_, true, __ATOMIC_RELEASE);
+  return true;
+}
+
+void Transport::onPairComplete(uint16_t handle, uint8_t auth_status) {
+  if (instance_) instance_->callback_events_.postPairComplete(handle, auth_status);
+}
+
+bool Transport::takeCommand(char* destination, size_t capacity) {
+  return command_ingress_.takeCommand(destination, capacity);
+}
+
+size_t Transport::writeLog(const uint8_t* bytes, size_t length) {
+  if (!enabled_) return length;
+  for (size_t index = 0; index < length; ++index) {
+    if (!line_buffer_ || unavailable_line_bytes_ != 0) {
+      // No allocation/entropy wait in the radio callback. If readiness changes
+      // mid-line, discard its remaining tail rather than admit a partial RAW.
+      ++unavailable_line_bytes_;
+      if (bytes[index] == '\n') {
+        if (log_queue_) log_queue_->rejectUnavailable(unavailable_line_bytes_);
+        else {
+          sequence_state_.skip();
+          ++prequeue_unavailable_records_;
+          prequeue_unavailable_bytes_ += unavailable_line_bytes_;
+        }
+        unavailable_line_bytes_ = 0;
+      }
+    } else line_buffer_->write(bytes[index]);
+  }
+  return length;
+}
+
+void Transport::service() {
+  if (!initialized_) return;
+  uint16_t event_handle = BLE_CONN_HANDLE_INVALID;
+  uint8_t event_status = 0;
+  if (callback_events_.takeDisconnect(event_handle) && connectionHandle() == event_handle) {
+    setConnectionHandle(BLE_CONN_HANDLE_INVALID);
+    admission_.disconnected(event_handle);
+    __atomic_store_n(&secured_, false, __ATOMIC_RELEASE);
+    delivery_.disconnected();
+    __atomic_store_n(&complete_record_sent_, false, __ATOMIC_RELEASE);
+    if (enrollment_handle_ == event_handle) enrollment_handle_ = BLE_CONN_HANDLE_INVALID;
+    command_ingress_.clear();
+    ack_length_ = 0;
+    if (log_queue_) log_queue_->restartHead();
+  }
+  if (callback_events_.takeConnect(event_handle)) {
+    BLEConnection* connection = Bluefruit.Connection(event_handle);
+    const bool enrolling = onboarding_ && policy_.enrollmentOpen(millis());
+    bool identity_known = false;
+    PeerIdentity identity{};
+    if (connection) {
+      const ble_gap_addr_t address = connection->getPeerAddr();
+      identity.type = address.addr_type;
+      memcpy(identity.address, address.addr, sizeof(identity.address));
+      // getPeerAddr() yields the persisted bond identity once the bond has loaded.
+      // Stable public/static addresses and S140-resolved RPAs are also comparable
+      // before slot assignment. Unresolved private addresses are held only under the
+      // bounded timeout and cannot access data or commands before bonded authorization.
+      identity_known = identityKnownAtConnect(connection->bonded(), address.addr_type, address.addr_id_peer);
+    }
+    const bool accepted = admitsCandidate(
+        enabled_, connectionHandle() == BLE_CONN_HANDLE_INVALID,
+        hasLiveConnection(connection != nullptr, connection && connection->connected()),
+        enrolling, enrollment_handle_ == BLE_CONN_HANDLE_INVALID,
+        policy_.hasPeer(), identity_known, identity, policy_.peer());
+    if (!accepted) {
+      if (connection) connection->disconnect();
+    } else {
+      setConnectionHandle(event_handle);
+      __atomic_store_n(&secured_, false, __ATOMIC_RELEASE);
+      connected_at_ = millis();
+      admission_.connected(event_handle, connected_at_);
+      if (enrolling) {
+        enrollment_handle_ = event_handle;
+        __atomic_store_n(&passkey_allowed_handle_, event_handle, __ATOMIC_RELEASE);
+      }
+    }
+  }
+  if (admission_.pending() && !policy_.enrollmentOpen(millis())) {
+    const uint16_t handle = connectionHandle();
+    BLEConnection* connection = Bluefruit.Connection(handle);
+    if (connection && connection->bonded() && connection->secured() && policy_.hasPeer()) {
+      const ble_gap_addr_t address = connection->getPeerAddr();
+      PeerIdentity identity{};
+      identity.type = address.addr_type;
+      memcpy(identity.address, address.addr, sizeof(identity.address));
+      if (!admission_.authorize(handle, identity, policy_.peer())) connection->disconnect();
+    }
+    uint16_t expired_handle = BLE_CONN_HANDLE_INVALID;
+    if (admission_.takeDisconnect(millis(), expired_handle)) {
+      BLEConnection* expired_connection = Bluefruit.Connection(expired_handle);
+      if (expired_connection) expired_connection->disconnect();
+    }
+  }
+  if (disable_pending_ && callback_events_.safeToReleaseQueue(enabled_, connectionHandle(), admission_.pending())) {
+    if (line_buffer_) line_buffer_->reset();
+    releaseQueue();
+    __atomic_store_n(&secured_, false, __ATOMIC_RELEASE);
+    disable_pending_ = false;
+  }
+  if (!enabled_) return;
+  if (onboarding_ && (!Serial || static_cast<uint32_t>(millis() - enrollment_started_) >= kEnrollmentWindowMs)) {
+    closeEnrollment();
+  }
+  // The loop is the sole snapshot writer; the GATT callback reads only this copy.
+  updateStatsSnapshot();
+  if (__atomic_exchange_n(&passkey_pending_, false, __ATOMIC_ACQ_REL) &&
+      Serial && onboarding_ && policy_.enrollmentOpen(millis())) {
+    Serial.print("Observer BLE passkey: ");
+    if (__atomic_load_n(&passkey_state_, __ATOMIC_ACQUIRE) == 1) {
+      Serial.write(pending_passkey_, sizeof(pending_passkey_));
+      __atomic_store_n(&passkey_state_, 0, __ATOMIC_RELEASE);
+    }
+    Serial.println();
+  }
+  if (callback_events_.takePairComplete(event_handle, event_status) && onboarding_ &&
+      event_handle == enrollment_handle_ && policy_.enrollmentOpen(millis())) {
+    pair_complete_handle_ = event_handle;
+    pair_complete_status_ = event_status;
+    __atomic_store_n(&pair_complete_pending_, true, __ATOMIC_RELEASE);
+  }
+  if (pair_complete_pending_) {
+    if (!__atomic_exchange_n(&pair_complete_pending_, false, __ATOMIC_ACQ_REL)) return;
+    const uint16_t handle = pair_complete_handle_;
+    const uint8_t status = pair_complete_status_;
+    if (status == BLE_GAP_SEC_STATUS_SUCCESS && onboarding_ &&
+        enrollment_handle_ == handle && policy_.enrollmentOpen(millis())) {
+      BLEConnection* connection = Bluefruit.Connection(handle);
+      if (!connection || !connection->bonded()) {
+        if (connection) connection->disconnect();
+      } else {
+        const ble_gap_addr_t address = connection->getPeerAddr();
+        PeerIdentity identity{};
+        identity.type = address.addr_type;
+        memcpy(identity.address, address.addr, sizeof(identity.address));
+        if (!policy_.enroll(identity, millis()) || !persistPeer(true, identity)) {
+          if (save_peer_) save_peer_(false, PeerIdentity{});
+          connection->removeBondKey();
+          policy_.revoke();
+          connection->disconnect();
+        } else {
+          onboarding_ = false;
+          __atomic_store_n(&passkey_allowed_handle_, BLE_CONN_HANDLE_INVALID, __ATOMIC_RELEASE);
+          __atomic_store_n(&passkey_pending_, false, __ATOMIC_RELEASE);
+          const uint16_t completed_handle = enrollment_handle_;
+          enrollment_handle_ = BLE_CONN_HANDLE_INVALID;
+          Bluefruit.Advertising.stop();
+          policy_.closeEnrollment();
+          if (completed_handle == connectionHandle()) disable_pending_ = true;
+          if (connection->secured()) {
+            admission_.authorize(handle, identity, identity);
+            __atomic_store_n(&secured_, true, __ATOMIC_RELEASE);
+          }
+          Serial.println("Observer BLE peer pinned; enrollment closed.");
+        }
+      }
+    }
+  }
+  if (callback_events_.takeSecured(event_handle) && connectionHandle() == event_handle &&
+      !policy_.enrollmentOpen(millis())) {
+    const bool allowed = authorizedAndSecured(event_handle);
+    __atomic_store_n(&secured_, allowed, __ATOMIC_RELEASE);
+    if (allowed) {
+      BLEConnection* connection = Bluefruit.Connection(event_handle);
+      if (connection) {
+        const ble_gap_addr_t address = connection->getPeerAddr();
+        PeerIdentity identity{};
+        identity.type = address.addr_type;
+        memcpy(identity.address, address.addr, sizeof(identity.address));
+        admission_.authorize(event_handle, identity, policy_.peer());
+      }
+    }
+  }
+  if (onboarding_ && static_cast<uint32_t>(millis() - enrollment_started_) >= kEnrollmentWindowMs) {
+    closeEnrollment();
+  }
+  if (!nonce_ready_) {
+    if (!refreshNonce()) return;
+  }
+  if (!log_queue_ && !allocateQueue()) { failInitialization(); return; }
+  serviceAdvertising();
+  // This loop is the only entropy/queue-session owner. Enqueue never calls
+  // SoftDevice or waits; exhausted admission loss is counted until fresh bytes
+  // are available. Already queued records retain their own session identities.
+  if (log_queue_ && log_queue_->sequenceExhausted() && refreshNonce(true)) {
+    log_queue_->setBootNonce(boot_nonce_);
+  }
+  if (policy_.enrollmentOpen(millis())) return;
+  if (!ack_length_) ack_ingress_.take(ack_, sizeof(ack_), ack_length_);
+  if (ack_length_) { processAck(ack_, ack_length_); ack_length_ = 0; }
+  const uint16_t handle = connectionHandle();
+  if (!enabled_ || !nonce_ready_ || !log_queue_ || !__atomic_load_n(&secured_, __ATOMIC_ACQUIRE) || !authorizedAndSecured(handle) ||
+      !log_characteristic_.notifyEnabled(handle) || log_queue_->empty()) return;
+  const unsigned long now = millis();
+  if (!delivery_.maySend(now)) return;
+  if (__atomic_load_n(&complete_record_sent_, __ATOMIC_ACQUIRE)) {
+    log_queue_->restartHead();
+    delivery_.restartWholeRecord();
+    __atomic_store_n(&complete_record_sent_, false, __ATOMIC_RELEASE);
+  }
+  RecordFragment fragment;
+  if (!log_queue_->peek(fragment, kNotificationBytes - kFrameHeaderBytes)) return;
+  uint8_t notification[kNotificationBytes];
+  const size_t encoded = encodeFrame(fragment.boot_nonce, fragment.sequence, fragment.total_length,
+                                     fragment.offset, fragment.bytes, fragment.length,
+                                     notification, sizeof(notification));
+  if (!encoded) return;
+  delivery_.attempted(now);
+  if (log_characteristic_.notify(handle, notification, encoded)) {
+    if (!log_queue_->consume(fragment.boot_nonce, fragment.sequence, fragment.length)) return;
+    const bool record_complete = (fragment.offset + fragment.length) == fragment.total_length;
+    __atomic_store_n(&complete_record_sent_, record_complete, __ATOMIC_RELEASE);
+    delivery_.fragmentSent(record_complete);
+  } else {
+    log_queue_->restartHead();
+    ++failed_notifications_;
+    delivery_.fragmentFailed();
+    __atomic_store_n(&complete_record_sent_, false, __ATOMIC_RELEASE);
+  }
+}
+
+size_t LogMirror::write(uint8_t byte) { return transport.writeLog(&byte, 1); }
+size_t LogMirror::write(const uint8_t* bytes, size_t length) { return transport.writeLog(bytes, length); }
+
+bool Transport::closeEnrollment() {
+  if (!onboarding_) return false;
+  __atomic_store_n(&passkey_allowed_handle_, BLE_CONN_HANDLE_INVALID, __ATOMIC_RELEASE);
+  __atomic_store_n(&passkey_pending_, false, __ATOMIC_RELEASE);
+  policy_.closeEnrollment();
+  onboarding_ = false;
+  const uint16_t closing_handle = enrollment_handle_;
+  if (enrollment_handle_ != BLE_CONN_HANDLE_INVALID) {
+    BLEConnection* connection = Bluefruit.Connection(enrollment_handle_);
+    if (connection) {
+      if (connection->bonded() && !policy_.hasPeer()) connection->removeBondKey();
+      connection->disconnect();
+    }
+  }
+  enrollment_handle_ = BLE_CONN_HANDLE_INVALID;
+  if (closing_handle != BLE_CONN_HANDLE_INVALID) disable_pending_ = true;
+  __atomic_store_n(&secured_, false, __ATOMIC_RELEASE);
+  Bluefruit.Advertising.stop();
+  Serial.println("Observer BLE enrollment closed.");
+  return true;
+}
+
+bool Transport::allocateQueue() {
+  if (!log_queue_) {
+    log_queue_ = new (std::nothrow) Queue(true, boot_nonce_, sequence_state_);
+    if (!log_queue_) return false;
+    line_buffer_ = new (std::nothrow) LineBuffer<256, kLogQueueBytes, Queue>(*log_queue_);
+    if (!line_buffer_) { delete log_queue_; log_queue_ = nullptr; return false; }
+  }
+  return true;
+}
+
+void Transport::releaseQueue() {
+  delete line_buffer_; line_buffer_ = nullptr;
+  delete log_queue_; log_queue_ = nullptr;
+}
+
+void Transport::updateStatsSnapshot() {
+  stats_snapshot_.publish(evictedRecords(), evictedBytes(), truncatedRecords(), truncatedBytes(), failedNotifications(),
+                          prequeue_unavailable_records_ + (log_queue_ ? log_queue_->unavailableRecords() : 0),
+                          prequeue_unavailable_bytes_ + (log_queue_ ? log_queue_->unavailableBytes() : 0));
+}
+
+bool Transport::persistPeer(bool has_peer, const PeerIdentity& peer) {
+  return save_peer_ && save_peer_(has_peer, peer);
+}
+
+}  // namespace observer
+
+#endif

diff --git a/src/observer/ObserverAckIngress.h b/src/observer/ObserverAckIngress.h
new file mode 100644
index 0000000000000000000000000000000000000000..a2496a75945fa4618fddaadb5fb194019a2e858f
--- /dev/null
+++ b/src/observer/ObserverAckIngress.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "ObserverProtocol.h"
+
+namespace observer {
+
+// One pending ACK is sufficient for stop-and-wait. A second write is rejected
+// until the main loop drains the slot; it can never overwrite a host command.
+class AckIngress {
+ public:
+  static constexpr size_t kCapacity = 95;
+
+  bool submit(const char* bytes, size_t length) {
+    Ack parsed{};
+    if (!bytes || length == 0 || length >= kCapacity ||
+        __atomic_load_n(&length_, __ATOMIC_ACQUIRE) != 0 ||
+        !parseAck(bytes, length, parsed)) return false;
+    memcpy(bytes_, bytes, length);
+    bytes_[length] = 0;
+    __atomic_store_n(&length_, length, __ATOMIC_RELEASE);
+    return true;
+  }
+
+  bool take(char* destination, size_t capacity, size_t& length) {
+    const size_t pending = __atomic_load_n(&length_, __ATOMIC_ACQUIRE);
+    if (!destination || capacity <= pending || pending == 0) return false;
+    length = pending;
+    memcpy(destination, bytes_, pending + 1);
+    __atomic_store_n(&length_, 0, __ATOMIC_RELEASE);
+    return true;
+  }
+
+  void clear() { __atomic_store_n(&length_, 0, __ATOMIC_RELEASE); }
+
+ private:
+  char bytes_[kCapacity]{};
+  size_t length_ = 0;
+};
+
+}  // namespace observer
diff --git a/src/observer/ObserverCallbackState.h b/src/observer/ObserverCallbackState.h
new file mode 100644
index 0000000000000000000000000000000000000000..1f23399e283665d52ab20cd679a5ab716467739b
--- /dev/null
+++ b/src/observer/ObserverCallbackState.h
@@ -0,0 +1,83 @@
+#pragma once
+
+#include <stdint.h>
+
+namespace observer {
+
+// One-slot atomic handoff. Callback tasks publish; the Arduino loop consumes.
+class CallbackEvents {
+ public:
+  bool postConnect(uint16_t handle) { return publish(connect_handle_, connect_state_, handle); }
+  bool postDisconnect(uint16_t handle) { return publish(disconnect_handle_, disconnect_state_, handle); }
+  bool postSecured(uint16_t handle) { return publish(secured_handle_, secured_state_, handle); }
+  bool postPairComplete(uint16_t handle, uint8_t status) {
+    if (!claim(pair_state_)) return false;
+    __atomic_store_n(&pair_handle_, handle, __ATOMIC_RELAXED);
+    __atomic_store_n(&pair_status_, status, __ATOMIC_RELAXED);
+    __atomic_store_n(&pair_state_, kReady, __ATOMIC_RELEASE);
+    return true;
+  }
+
+  bool takeConnect(uint16_t& handle) { return take(connect_handle_, connect_state_, handle); }
+  bool takeDisconnect(uint16_t& handle) { return take(disconnect_handle_, disconnect_state_, handle); }
+  bool takeSecured(uint16_t& handle) { return take(secured_handle_, secured_state_, handle); }
+  bool takePairComplete(uint16_t& handle, uint8_t& status) {
+    if (!claimReady(pair_state_)) return false;
+    handle = __atomic_load_n(&pair_handle_, __ATOMIC_RELAXED);
+    status = __atomic_load_n(&pair_status_, __ATOMIC_RELAXED);
+    __atomic_store_n(&pair_state_, kEmpty, __ATOMIC_RELEASE);
+    return true;
+  }
+
+  bool pending() const {
+    return __atomic_load_n(&connect_state_, __ATOMIC_ACQUIRE) != kEmpty ||
+           __atomic_load_n(&disconnect_state_, __ATOMIC_ACQUIRE) != kEmpty ||
+           __atomic_load_n(&secured_state_, __ATOMIC_ACQUIRE) != kEmpty ||
+           __atomic_load_n(&pair_state_, __ATOMIC_ACQUIRE) != kEmpty;
+  }
+  bool safeToReleaseQueue(bool enabled, uint16_t active_handle) const {
+    return !enabled && active_handle == kInvalidHandle && !pending();
+  }
+  bool safeToReleaseQueue(bool enabled, uint16_t active_handle, bool admission_pending) const {
+    return !enabled && active_handle == kInvalidHandle && !pending() && !admission_pending;
+  }
+
+ private:
+  static constexpr uint8_t kEmpty = 0;
+  static constexpr uint8_t kWriting = 1;
+  static constexpr uint8_t kReady = 2;
+  static constexpr uint16_t kInvalidHandle = 0xFFFF;
+
+  static bool claim(volatile uint8_t& state) {
+    uint8_t expected = kEmpty;
+    return __atomic_compare_exchange_n(&state, &expected, kWriting, false, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED);
+  }
+  static bool claimReady(volatile uint8_t& state) {
+    uint8_t expected = kReady;
+    return __atomic_compare_exchange_n(&state, &expected, kWriting, false, __ATOMIC_ACQ_REL, __ATOMIC_RELAXED);
+  }
+  static bool publish(volatile uint16_t& slot, volatile uint8_t& state, uint16_t handle) {
+    if (!claim(state)) return false;
+    __atomic_store_n(&slot, handle, __ATOMIC_RELAXED);
+    __atomic_store_n(&state, kReady, __ATOMIC_RELEASE);
+    return true;
+  }
+  static bool take(volatile uint16_t& slot, volatile uint8_t& state, uint16_t& handle) {
+    if (!claimReady(state)) return false;
+    handle = __atomic_load_n(&slot, __ATOMIC_RELAXED);
+    __atomic_store_n(&state, kEmpty, __ATOMIC_RELEASE);
+    return true;
+  }
+
+  volatile uint16_t connect_handle_ = kInvalidHandle;
+  volatile uint16_t disconnect_handle_ = kInvalidHandle;
+  volatile uint16_t secured_handle_ = kInvalidHandle;
+  volatile uint16_t pair_handle_ = kInvalidHandle;
+  volatile uint8_t pair_status_ = 0;
+  volatile uint8_t connect_state_ = kEmpty;
+  volatile uint8_t disconnect_state_ = kEmpty;
+  volatile uint8_t secured_state_ = kEmpty;
+  volatile uint8_t pair_state_ = kEmpty;
+};
+
+}  // namespace observer
diff --git a/src/observer/ObserverCommand.h b/src/observer/ObserverCommand.h
new file mode 100644
index 0000000000000000000000000000000000000000..f17f75f29b2d3dc3aff6e771166a08c1a50b3c59
--- /dev/null
+++ b/src/observer/ObserverCommand.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <stdint.h>
+#include <string.h>
+
+namespace observer {
+
+inline bool parseCanonicalEpoch(const char* command, uint32_t& epoch) {
+  if (strncmp(command, "time ", 5) != 0 || command[5] == 0) return false;
+  const char* digits = command + 5;
+  if (digits[0] == '0' && digits[1] != 0) return false;
+  uint64_t parsed = 0;
+  for (const char* current = digits; *current; ++current) {
+    if (*current < '0' || *current > '9') return false;
+    parsed = parsed * 10 + static_cast<uint8_t>(*current - '0');
+    if (parsed > UINT32_MAX) return false;
+  }
+  epoch = static_cast<uint32_t>(parsed);
+  return true;
+}
+
+inline bool isAllowedReadCommand(const char* command) {
+  static const char* const allowed[] = {
+      "get name", "get public.key", "get prv.key", "get radio", "ver", "board",
+      "stats-core", "stats-radio", "stats-packets"};
+  for (const char* candidate : allowed) {
+    if (strcmp(command, candidate) == 0) return true;
+  }
+  return false;
+}
+
+}  // namespace observer
diff --git a/src/observer/ObserverCommandIngress.h b/src/observer/ObserverCommandIngress.h
new file mode 100644
index 0000000000000000000000000000000000000000..565be7befb92833a73f24d770f5c13117a44dfbc
--- /dev/null
+++ b/src/observer/ObserverCommandIngress.h
@@ -0,0 +1,37 @@
+#pragma once
+
+#include <stddef.h>
+#include <string.h>
+
+namespace observer {
+
+// Independent one-entry host command slot; ACK traffic has its own slot.
+class CommandIngress {
+ public:
+  static constexpr size_t kCapacity = 96;
+
+  bool submitCommand(const char* bytes, size_t length) {
+    if (!bytes || length == 0 || length >= kCapacity || memchr(bytes, 0, length) ||
+        __atomic_load_n(&length_, __ATOMIC_ACQUIRE) != 0) return false;
+    memcpy(bytes_, bytes, length);
+    bytes_[length] = 0;
+    __atomic_store_n(&length_, length, __ATOMIC_RELEASE);
+    return true;
+  }
+
+  bool takeCommand(char* destination, size_t capacity) {
+    const size_t pending = __atomic_load_n(&length_, __ATOMIC_ACQUIRE);
+    if (!destination || pending == 0 || capacity <= pending) return false;
+    memcpy(destination, bytes_, pending + 1);
+    __atomic_store_n(&length_, 0, __ATOMIC_RELEASE);
+    return true;
+  }
+
+  void clear() { __atomic_store_n(&length_, 0, __ATOMIC_RELEASE); }
+
+ private:
+  char bytes_[kCapacity]{};
+  size_t length_ = 0;
+};
+
+}  // namespace observer
diff --git a/src/observer/ObserverConnectionAdmission.h b/src/observer/ObserverConnectionAdmission.h
new file mode 100644
index 0000000000000000000000000000000000000000..2d62b90d910bdd00eb5c595357f8e80855c77dd2
--- /dev/null
+++ b/src/observer/ObserverConnectionAdmission.h
@@ -0,0 +1,69 @@
+#pragma once
+
+#include <stdint.h>
+
+#include "ObserverPolicy.h"
+
+namespace observer {
+
+// Stable public/static addresses are directly comparable at connection time;
+// resolved RPAs carry the identity address according to S140, while unresolved
+// private addresses must wait for the secured bond identity under the timeout.
+inline bool identityKnownAtConnect(bool bonded, uint8_t address_type, uint8_t address_id_peer) {
+  return bonded || address_id_peer != 0 || address_type == 0 || address_type == 1;
+}
+
+inline bool hasLiveConnection(bool connection_exists, bool connected) {
+  return connection_exists && connected;
+}
+
+// Decides whether a freshly connected handle may occupy the single peripheral slot.
+inline bool admitsCandidate(bool enabled, bool slot_free, bool link_connected,
+                            bool enrolling, bool enrollment_slot_free,
+                            bool has_pinned, bool identity_known,
+                            const PeerIdentity& observed, const PeerIdentity& pinned) {
+  if (!enabled || !slot_free || !link_connected) return false;
+  if (enrolling) return enrollment_slot_free;
+  if (!has_pinned) return false;
+  if (identity_known) return samePeer(observed, pinned);
+  return true;
+}
+
+class ConnectionAdmission {
+ public:
+  explicit ConnectionAdmission(uint32_t timeout_ms) : timeout_ms_(timeout_ms) {}
+  bool connected(uint16_t handle, uint32_t now) {
+    if (handle_ != kInvalidHandle) return false;
+    handle_ = handle;
+    connected_at_ = now;
+    authorized_ = false;
+    return true;
+  }
+  bool authorize(uint16_t handle, const PeerIdentity& peer, const PeerIdentity& intended) {
+    if (handle != handle_ || !samePeer(peer, intended)) return false;
+    authorized_ = true;
+    return true;
+  }
+  bool expired(uint32_t now) const {
+    return handle_ != kInvalidHandle && !authorized_ &&
+           static_cast<uint32_t>(now - connected_at_) >= timeout_ms_;
+  }
+  bool takeDisconnect(uint32_t now, uint16_t& handle) {
+    if (!expired(now)) return false;
+    handle = handle_;
+    reset();
+    return true;
+  }
+  void disconnected(uint16_t handle) { if (handle_ == handle) reset(); }
+  bool authorized() const { return authorized_; }
+  bool pending() const { return handle_ != kInvalidHandle && !authorized_; }
+ private:
+  static constexpr uint16_t kInvalidHandle = 0xFFFF;
+  void reset() { handle_ = kInvalidHandle; connected_at_ = 0; authorized_ = false; }
+  uint32_t timeout_ms_;
+  uint32_t connected_at_ = 0;
+  uint16_t handle_ = kInvalidHandle;
+  bool authorized_ = false;
+};
+
+}  // namespace observer
diff --git a/src/observer/ObserverDelivery.h b/src/observer/ObserverDelivery.h
new file mode 100644
index 0000000000000000000000000000000000000000..b557303c3eb1092e82c9de7a3557809ff6c8d152
--- /dev/null
+++ b/src/observer/ObserverDelivery.h
@@ -0,0 +1,45 @@
+#pragma once
+
+#include <stdint.h>
+
+namespace observer {
+
+// Nonblocking stop-and-wait timing state, independent of BLE/Arduino.
+class DeliverySchedule {
+ public:
+  explicit DeliverySchedule(uint32_t retry_interval_ms, uint32_t fragment_interval_ms = 10)
+      : retry_interval_ms_(retry_interval_ms), fragment_interval_ms_(fragment_interval_ms) {}
+
+  bool maySend(uint32_t now) const {
+    return !waiting_ || static_cast<uint32_t>(now - last_attempt_) >=
+                            (complete_ ? retry_interval_ms_ : fragment_interval_ms_);
+  }
+
+  void attempted(uint32_t now) {
+    last_attempt_ = now;
+    waiting_ = true;
+  }
+
+  void fragmentSent(bool record_complete) {
+    if (record_complete) complete_ = true;
+  }
+
+  bool restartWholeRecord() {
+    if (!complete_) return false;
+    complete_ = false;
+    return true;
+  }
+
+  void fragmentFailed() { complete_ = false; }
+  void disconnected() { waiting_ = false; complete_ = false; }
+  void acknowledged() { waiting_ = false; complete_ = false; }
+
+ private:
+  uint32_t retry_interval_ms_;
+  uint32_t fragment_interval_ms_;
+  uint32_t last_attempt_ = 0;
+  bool waiting_ = false;
+  bool complete_ = false;
+};
+
+}  // namespace observer
diff --git a/src/observer/ObserverLineBuffer.h b/src/observer/ObserverLineBuffer.h
new file mode 100644
index 0000000000000000000000000000000000000000..271fa618a63bbf08225a3a6a9d4270a0519caa94
--- /dev/null
+++ b/src/observer/ObserverLineBuffer.h
@@ -0,0 +1,60 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+namespace observer {
+
+template <size_t LineCapacity, size_t QueueCapacity, typename Queue = StreamQueue<QueueCapacity>,
+          typename OverflowReporter = Queue>
+class LineBuffer {
+ public:
+  explicit LineBuffer(Queue& queue)
+      : queue_(queue), overflow_reporter_(nullptr) {}
+  LineBuffer(Queue& queue, OverflowReporter& overflow_reporter)
+      : queue_(queue), overflow_reporter_(&overflow_reporter) {}
+
+  size_t write(const uint8_t* bytes, size_t length) {
+    for (size_t index = 0; index < length; ++index) write(bytes[index]);
+    return length;
+  }
+
+  size_t write(uint8_t byte) {
+    // The byte that exceeds capacity can itself be the terminator. Process it
+    // in the discard state immediately, not as the start of another lost line.
+    if (line_length_ == LineCapacity) overflowed_ = true;
+    if (overflowed_) {
+      if (byte == '\n') {
+        if (overflow_reporter_) overflow_reporter_->drop(line_length_ + 1);
+        else queue_.drop(line_length_ + 1);
+        line_length_ = 0;
+        overflowed_ = false;
+      } else {
+        ++line_length_;
+      }
+      return 1;
+    }
+    line_[line_length_++] = byte;
+    if (byte == '\n') commitLine();
+    return 1;
+  }
+
+  void reset() {
+    line_length_ = 0;
+    overflowed_ = false;
+  }
+
+ private:
+  void commitLine() {
+    queue_.enqueue(line_, line_length_);
+    line_length_ = 0;
+  }
+
+  Queue& queue_;
+  OverflowReporter* overflow_reporter_;
+  uint8_t line_[LineCapacity]{};
+  size_t line_length_ = 0;
+  bool overflowed_ = false;
+};
+
+}  // namespace observer

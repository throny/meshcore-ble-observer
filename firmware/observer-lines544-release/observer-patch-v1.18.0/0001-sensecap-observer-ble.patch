+  File open(const char* path, const char* mode, bool) {
+    if (strcmp(path, "/prefs.json") != 0 || strcmp(mode, "w") != 0) return {};
+    prefs_.clear();
+    has_prefs_ = true;
+    return File(&prefs_, true);
+  }
+  bool remove(const char* path) {
+    if (strcmp(path, "/prefs.json") != 0) return false;

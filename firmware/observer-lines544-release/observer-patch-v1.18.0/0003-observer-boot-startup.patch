+  expect_no_start(unknown);
+
+  observer::ObserverNodePrefs disabled;
+  disabled.observer_version_ = observer::ObserverNodePrefs::kObserverVersion;
+  disabled.observer_enabled = 0;
+  expect_no_start(disabled);
